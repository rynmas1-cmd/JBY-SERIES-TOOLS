<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Facebook Checker — JBY Series Pro</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600;700&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #030712;
      --card-bg: rgba(15, 23, 42, 0.85);
      --neon-cyan: #00f0ff;
      --neon-green: #00ff66;
      --neon-red: #ff3366;
      --border-cyan: rgba(0, 240, 255, 0.25);
      --text-main: #f8fafc;
      --text-muted: #64748b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      background-image: 
        linear-gradient(rgba(0, 240, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 240, 255, 0.03) 1px, transparent 1px);
      background-size: 30px 30px;
      color: var(--text-main);
      font-family: 'Fira Code', monospace;
      padding: 40px 20px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      max-width: 900px;
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border-cyan);
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);
    }

    .nav-back {
      display: inline-block;
      color: var(--neon-cyan);
      text-decoration: none;
      font-size: 0.85rem;
      margin-bottom: 20px;
      font-weight: 600;
    }

    h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.6rem;
      color: #fff;
      margin-bottom: 20px;
      text-transform: uppercase;
    }

    textarea {
      width: 100%;
      height: 180px;
      padding: 14px;
      background: rgba(3, 7, 18, 0.9);
      border: 1px solid var(--border-cyan);
      border-radius: 6px;
      color: var(--neon-green);
      font-family: 'Fira Code', monospace;
      margin-bottom: 20px;
      resize: vertical;
    }

    .btn-group {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }

    button {
      padding: 12px 24px;
      background: transparent;
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s;
    }

    button:hover {
      background: var(--neon-cyan);
      color: var(--bg);
      box-shadow: 0 0 15px var(--neon-cyan);
    }

    .counter {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      font-size: 0.9rem;
    }

    .counter-live { color: var(--neon-green); }
    .counter-dead { color: var(--neon-red); }

    .result-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .res-panel {
      background: rgba(3, 7, 18, 0.8);
      border: 1px solid var(--border-cyan);
      padding: 16px;
      border-radius: 6px;
      max-height: 250px;
      overflow-y: auto;
      font-size: 0.82rem;
    }

    .res-panel.live { border-color: var(--neon-green); color: var(--neon-green); }
    .res-panel.dead { border-color: var(--neon-red); color: var(--neon-red); }

    @media (max-width: 600px) {
      .result-box { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <div class="container">
    <a href="index.html" class="nav-back">◄ KEMBALI KE DASHBOARD</a>
    <h1>FACEBOOK LIVE CHECKER</h1>

    <textarea id="listUid" placeholder="Masukkan daftar UID / Email Facebook (1 per baris)..."></textarea>

    <div class="btn-group">
      <button onclick="startCheck()">⚡ MULAI CEK</button>
    </div>

    <div class="counter">
      <div>TOTAL: <span id="txtTotal">0</span></div>
      <div class="counter-live">LIVE: <span id="txtLive">0</span></div>
      <div class="counter-dead">DEAD: <span id="txtDead">0</span></div>
    </div>

    <div class="result-box">
      <div>
        <div style="color: var(--neon-green); margin-bottom: 8px; font-weight:700;">LIVE ACCOUNTS</div>
        <div id="boxLive" class="res-panel live"></div>
      </div>
      <div>
        <div style="color: var(--neon-red); margin-bottom: 8px; font-weight:700;">DEAD / CHECKPOINT</div>
        <div id="boxDead" class="res-panel dead"></div>
      </div>
    </div>
  </div>

  <script>
    async function startCheck() {
      const rawText = document.getElementById('listUid').value.trim();
      if (!rawText) return alert("Masukkan daftar UID terlebih dahulu!");

      const uids = rawText.split('\n').map(line => line.trim()).filter(line => line.length > 0);
      
      document.getElementById('txtTotal').innerText = uids.length;
      document.getElementById('txtLive').innerText = 0;
      document.getElementById('txtDead').innerText = 0;
      document.getElementById('boxLive').innerHTML = '';
      document.getElementById('boxDead').innerHTML = '';

      let countLive = 0;
      let countDead = 0;

      for (let uidRaw of uids) {
        // Ambil ID utama jika format berupa UID|PASS
        const uid = uidRaw.split('|')[0];

        try {
          // Graph API Public Avatar Facebook
          const res = await fetch(`https://graph.facebook.com/${uid}/picture?type=normal&redirect=false`);
          const data = await res.json();

          if (data && data.data && !data.error) {
            countLive++;
            document.getElementById('txtLive').innerText = countLive;
            document.getElementById('boxLive').innerHTML += `<div>[LIVE] ${uidRaw}</div>`;
          } else {
            countDead++;
            document.getElementById('txtDead').innerText = countDead;
            document.getElementById('boxDead').innerHTML += `<div>[DEAD] ${uidRaw}</div>`;
          }
        } catch (e) {
          countDead++;
          document.getElementById('txtDead').innerText = countDead;
          document.getElementById('boxDead').innerHTML += `<div>[DEAD] ${uidRaw}</div>`;
        }
      }
    }
  </script>
</body>
</html>
